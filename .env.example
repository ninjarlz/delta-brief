# Copy to .env (gitignored) and fill in your own values. Auto-loaded by
# ./gradlew bootRun — see build.gradle's `bootRun` task.

# Free Resend account API key (https://resend.com) — needed to test the
# registration verification email locally. Until a domain is verified with
# Resend (see plan.md Phase 4), the default sender (onboarding@resend.dev)
# can only deliver to the email address your Resend account itself uses —
# register locally with that same address to actually receive the email.
RESEND_API_KEY=
